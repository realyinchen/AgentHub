# AgentHub Backend Environment Configuration
#
# Edit this file to add your 3rd-party API keys (Tavily, Amap, LangSmith, etc.)
# LLM API keys are configured in Web UI (http://localhost:5173 -> Settings)
#
# =============================================================================
# 📦 APPLICATION MODE
# =============================================================================
#
# Application mode: dev | prod
#   dev  -> LangSmith tracing allowed, CORS relaxed
#   prod -> LangSmith tracing disabled, CORS strict
#
# Database is always PostgreSQL + pgvector regardless of MODE.
MODE=dev

# Web server configuration
HOST=0.0.0.0
PORT=8080
# Set false on Windows local development if uvicorn reload subprocesses fail.
UVICORN_RELOAD=true

# =============================================================================
# System-level Default MODEL (Required)
# =============================================================================
SYSTEM_DEFAULT_LLM_MODEL=dashscope/qwen3.6-27b
SYSTEM_DEFAULT_LLM_API_KEY=sk-d2a977d335d740d7ae6ae5***********1b
SYSTEM_DEFAULT_EMBEDDING_MODEL=dashscope/text-embedding-v4

# Optional: set when SYSTEM_DEFAULT_LLM_MODEL points to an OpenAI-compatible
# local server such as LM Studio.
# Example:
#   SYSTEM_DEFAULT_LLM_MODEL=lmstudio/qwen3-8b
#   SYSTEM_DEFAULT_LLM_API_KEY=lm-studio
#   SYSTEM_DEFAULT_LLM_BASE_URL=http://127.0.0.1:1234/v1
# Docker backend -> host LM Studio:
#   SYSTEM_DEFAULT_LLM_BASE_URL=http://host.docker.internal:1234/v1
#
# OpenRouter example using a free model:
#   SYSTEM_DEFAULT_LLM_MODEL=openrouter/nex-agi/nex-n2-pro:free
#   SYSTEM_DEFAULT_LLM_API_KEY=sk-or-v1-...
#   SYSTEM_DEFAULT_LLM_BASE_URL=https://openrouter.ai/api/v1
SYSTEM_DEFAULT_LLM_BASE_URL=
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_X_TITLE=AgentHub

# Default embedding dimension for vector databases
EMBEDDING_DIMENSION=1024

# =============================================================================
# 🔐 API Key Encryption (REQUIRED for ALL environments)
# =============================================================================
API_KEY_ENCRYPTION_KEY=AgentHub2026SecureKey!@#$%

# =============================================================================
# 🔑 JWT Authentication (REQUIRED for ALL environments)
# =============================================================================
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# =============================================================================
# LangSmith Tracing Configuration (Optional)
# =============================================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT="AgentHub"
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_6e65597345df44d381e2e5f4a04e16b8_**********

# =============================================================================
# PostgreSQL Configuration (required for ALL environments)
# =============================================================================
# Docker deployment: use 'db' as host (the service name in docker-compose.yml)
# Local development: use 'localhost' as host
POSTGRES_USER=langchain
POSTGRES_PASSWORD=langgraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentdb
POSTGRES_SSL_MODE=prefer

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:5173

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Tavily Search API (Optional, required for web search tool)
# =============================================================================
TAVILY_API_KEY=tvly-dev-Kd*************AVWMEmueoi5p8p

# =============================================================================
# Amap (Gaode Maps) Configuration (Optional)
# =============================================================================
AMAP_KEY=542534f8a6*************c31fca2ec2

# =============================================================================
# WeChat iLink Bot API Configuration (Optional)
# =============================================================================
WEIXIN_ILINK_BASE_URL=https://ilinkai.weixin.qq.com
